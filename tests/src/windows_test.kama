// Which roots the Windows import keeps, decided on certificate stores made in memory (tests/csrc/windows_roots.c), so
// the machine's own stores are never touched: a root Windows allows for server authentication is kept, and one it
// restricts to other uses, turns off, or also holds in its Disallowed store is not. Elsewhere there is nothing to run.
import { std::io::IoError, std::collections::DynamicArray, std::collections::ConstView, std::fs::readFile,
         tls_tests::check, tls_tests::fail, tls_tests::certPath };
export { windowsTests };

@compileFor(OS_WINDOWS)
extern "windows_roots.h";
@compileFor(OS_WINDOWS)
extern fn int32 ktls_test_root_verdict(UnsafeConstPtr<uint8> der, usize len, int32 eku, int32 disallow);

// The EKU property the in-memory store gives a root (windows_roots.h).
comptime int32 EKU_NONE = 0;
comptime int32 EKU_CLIENT = 1;
comptime int32 EKU_BOTH = 2;
comptime int32 EKU_EMPTY = 3;

@compileFor(OS_WINDOWS)
fn DynamicArray<uint8> derOf(const ref string name) {
    Result<DynamicArray<uint8>, IoError> read = readFile(path: certPath(name: name));
    return match (give read) { case Ok(value: b): give b; case Err(error: e): fail::<DynamicArray<uint8>>(msg: "read fixture"); };
}

@compileFor(OS_WINDOWS)
unsafe fn bool kept(ConstView<uint8> der, int32 eku, int32 disallow, string what) {
    int32 v = ktls_test_root_verdict(der: der.dataPtr(), len: cast<usize>(der.length()), eku: eku, disallow: disallow);
    if (v < 0) { return fail::<bool>(msg: "windows roots: the in-memory stores for '${what}'"); }
    return v == 1;
}

@compileFor(OS_WINDOWS)
unsafe fn int32 windowsTests() {
    int32 f = 0;
    DynamicArray<uint8> ca = derOf(name: "ca.der");
    DynamicArray<uint8> signing = derOf(name: "eku-ca.der");
    f = f + check(ok: kept(der: ca.view(), eku: EKU_NONE, disallow: 0, what: "plain"), what: "windows roots: a root with no usage restriction is kept");
    f = f + check(ok: kept(der: ca.view(), eku: EKU_BOTH, disallow: 0, what: "both"), what: "windows roots: a root the store allows server authentication is kept");
    f = f + check(ok: !kept(der: ca.view(), eku: EKU_CLIENT, disallow: 0, what: "client"), what: "windows roots: a root the store allows client authentication alone is skipped");
    f = f + check(ok: !kept(der: ca.view(), eku: EKU_EMPTY, disallow: 0, what: "empty"), what: "windows roots: a root the store turns off for every purpose is skipped");
    f = f + check(ok: !kept(der: ca.view(), eku: EKU_NONE, disallow: 1, what: "disallowed"), what: "windows roots: a root the Disallowed store also holds is skipped");
    f = f + check(ok: !kept(der: signing.view(), eku: EKU_NONE, disallow: 0, what: "code signing"), what: "windows roots: a root whose own EKU is code signing alone is skipped");
    f = f + check(ok: !kept(der: signing.view(), eku: EKU_BOTH, disallow: 0, what: "widened"), what: "windows roots: a store property cannot widen a root's own EKU");
    return f;
}

@compileFor(!OS_WINDOWS)
fn int32 windowsTests() { return 0; }
